NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional — notifikasi email saat cuti disetujui/ditolak (src/lib/email/).
# Kalau dikosongkan, HrCash tetap jalan normal, cuma tidak kirim email.
# Daftar & buat API key di https://resend.com/api-keys
RESEND_API_KEY=
# Wajib pakai domain yang sudah diverifikasi di Resend untuk produksi.
# Kosongkan untuk pakai alamat testing bawaan Resend (onboarding@resend.dev).
RESEND_FROM_EMAIL=

# Opsional — tombol "Lihat Demo" di landing page (src/app/demo,
# src/app/demo-portal). Isi setelah data demo dibuat lewat
# supabase/seed/README.md. Kalau dikosongkan, tombolnya fallback ke /login.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=
DEMO_PORTAL_SLUG=
